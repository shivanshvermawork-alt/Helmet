{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Upload Arduino 1 (Transmitter / Helmet)",
            "type": "shell",
            "command": "\"${env:USERPROFILE}\\.antigravity-ide\\extensions\\vsciot-vscode.vscode-arduino-0.7.1\\assets\\platform\\win32-x64\\arduino-cli\\arduino-cli.exe\" compile --upload -p COM5 --fqbn arduino:avr:uno \"${workspaceFolder}\\Blink\"",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Upload Arduino 2 (Receiver / Bike Unit)",
            "type": "shell",
            "command": "\"${env:USERPROFILE}\\.antigravity-ide\\extensions\\vsciot-vscode.vscode-arduino-0.7.1\\assets\\platform\\win32-x64\\arduino-cli\\arduino-cli.exe\" compile --upload -p COM4 --fqbn arduino:avr:uno \"${workspaceFolder}\\Receiver\"",
            "problemMatcher": []
        },
        {
            "label": "Monitor Arduino 1 (COM5 - Helmet Transmitter)",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}\\monitor.ps1\" -portName COM5",
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Monitor Arduino 2 (COM4 - Bike Receiver)",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}\\monitor.ps1\" -portName COM4",
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true
            },
            "problemMatcher": []
        }
    ]
}
