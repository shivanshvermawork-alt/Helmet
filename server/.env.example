# ========================================================
# AegisHelm Emergency Dispatch & Cloud SMS Configuration
# ========================================================

# 1. Twilio Cloud SMS (Optional - for real cellular SMS)
# Get free credentials at: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 2. Telegram Bot Notifications (Optional - 100% Free instant messaging)
# Create a bot via @BotFather in Telegram and get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3. Default Emergency Contact Phone
EMERGENCY_CONTACT_PHONE=+919876543210
